import { vi, describe, it, expect, beforeEach, afterEach } from 'vitest';
import { EventEmitter } from 'node:events';

// Mock child_process.spawn
vi.mock('node:child_process', () => ({
  spawn: vi.fn(),
  exec: vi.fn(),
}));

// Mock net.Socket — connect 回调自动触发
class MockSocket extends EventEmitter {
  setEncoding = vi.fn();
  write = vi.fn();
  destroy = vi.fn();
  connect(_port: number, _host: string, cb?: () => void) {
    if (cb) setImmediate(cb);
    return this;
  }
}

vi.mock('node:net', () => ({
  Socket: vi.fn(() => new MockSocket() as any),
}));

import { spawn } from 'node:child_process';
import { Socket } from 'node:net';
import { parseRegisters, parseMemory, parseFlashBanks } from '../tcl-parser.js';
import { OpenOCDClient, OpenOCDConfig } from '../openocd-client.js';

// ============================================================
// 1. Complete register parsing flow
// ============================================================
describe('Register parsing integration', () => {
  it('should parse realistic reg output (r0-r3, sp, lr, pc, xPSR)', () => {
    // Simulate ARM Cortex-M reg command output with header and 17 registers
    const input = `===== arm v7m registers
(0) r0 (/32): 0x20001000
(1) r1 (/32): 0x00000001
(2) r2 (/32): 0x08001234
(3) r3 (/32): 0xDEADBEEF
(4) r4 (/32): 0x00000000
(5) r5 (/32): 0x08002000
(6) r6 (/32): 0x08003000
(7) r7 (/32): 0x08004000
(8) r8 (/32): 0x00000000
(9) r9 (/32): 0x00000000
(10) r10 (/32): 0x00000000
(11) r11 (/32): 0x00000000
(12) r12 (/32): 0x00000000
(13) sp (/32): 0x20002000
(14) lr (/32): 0x08005678
(15) pc (/32): 0x08005678
(16) xPSR (/32): 0x01000000`;

    const result = parseRegisters(input);

    // Expect 17 registers (header line is ignored)
    expect(result).toHaveLength(17);

    // Verify general-purpose registers r0-r3
    expect(result[0]).toEqual({ name: 'r0', number: 0, value: '0x20001000' });
    expect(result[1]).toEqual({ name: 'r1', number: 1, value: '0x00000001' });
    expect(result[2]).toEqual({ name: 'r2', number: 2, value: '0x08001234' });
    expect(result[3]).toEqual({ name: 'r3', number: 3, value: '0xDEADBEEF' });

    // Verify special registers sp, lr, pc, xPSR by name lookup
    const spReg = result.find((r) => r.name === 'sp');
    expect(spReg).toBeDefined();
    expect(spReg!.value).toBe('0x20002000');

    const lrReg = result.find((r) => r.name === 'lr');
    expect(lrReg).toBeDefined();
    expect(lrReg!.value).toBe('0x08005678');

    const pcReg = result.find((r) => r.name === 'pc');
    expect(pcReg).toBeDefined();
    expect(pcReg!.value).toBe('0x08005678');

    const xpsrReg = result.find((r) => r.name === 'xPSR');
    expect(xpsrReg).toBeDefined();
    expect(xpsrReg!.value).toBe('0x01000000');

    // pc and lr share the same value, simulating a loop waiting for interrupt
    expect(pcReg!.value).toBe(lrReg!.value);
  });

  it('should verify all register values are within 32-bit range', () => {
    const input = `(0) r0 (/32): 0x20001000
(13) sp (/32): 0xFFFFFFFF
(14) lr (/32): 0x00000000
(15) pc (/32): 0x08005678`;

    const result = parseRegisters(input);
    for (const reg of result) {
      const val = parseInt(reg.value, 16);
      expect(val).toBeGreaterThanOrEqual(0);
      expect(val).toBeLessThanOrEqual(0xFFFFFFFF);
    }
  });

  it('should return empty array for empty input', () => {
    expect(parseRegisters('')).toEqual([]);
    expect(parseRegisters('  \n\n  ')).toEqual([]);
  });

  it('should safely skip non-matching lines', () => {
    const input = `some random text
(0) r0 (/32): 0x20001000
===== separator line =====`;
    const result = parseRegisters(input);
    expect(result).toHaveLength(1);
    expect(result[0].name).toBe('r0');
  });
});

// ============================================================
// 2. Complete Flash Bank parsing flow
// ============================================================
describe('Flash Bank parsing integration', () => {
  it('should parse multi-bank Flash configuration', () => {
    const input = `#0 : stm32f1x.flash at 0x08000000, size 0x00010000, buswidth 0, chipwidth 0
#1 : stm32f2x.flash at 0x08010000, size 0x00020000, buswidth 0, chipwidth 0`;

    const result = parseFlashBanks(input);
    expect(result).toHaveLength(2);

    expect(result[0]).toEqual({
      bank: 0,
      driver: 'stm32f1x.flash',
      address: '0x08000000',
      size: '0x00010000',
    });

    expect(result[1]).toEqual({
      bank: 1,
      driver: 'stm32f2x.flash',
      address: '0x08010000',
      size: '0x00020000',
    });
  });

  it('should handle empty or invalid input gracefully', () => {
    expect(parseFlashBanks('')).toEqual([]);
    expect(parseFlashBanks('invalid line\nanother invalid line')).toEqual([]);
    expect(parseFlashBanks('\n\n')).toEqual([]);
  });
});

// ============================================================
// 3. Memory read parsing flow
// ============================================================
describe('Memory read parsing integration', () => {
  it('should parse mdw command output (word mode, 4-byte aligned)', () => {
    // Simulate reading 8 words starting from 0x08000000
    const input = `0x08000000: 20001000
0x08000004: 08001234
0x08000008: 00000001
0x0800000C: DEADBEEF
0x08000010: 08005678
0x08000014: 01000000
0x08000018: 20002000
0x0800001C: 00000000`;

    const result = parseMemory(input);
    expect(result).toHaveLength(8);

    // Verify address continuity (4-byte increments)
    for (let i = 1; i < result.length; i++) {
      const prevAddr = parseInt(result[i - 1].address, 16);
      const currAddr = parseInt(result[i].address, 16);
      expect(currAddr - prevAddr).toBe(4);
    }

    // Verify first and last entries
    expect(result[0]).toEqual({ address: '0x08000000', value: '20001000' });
    expect(result[7]).toEqual({ address: '0x0800001C', value: '00000000' });
  });

  it('should parse mdb command output (byte mode)', () => {
    const input = `0x20000000: AB
0x20000001: CD
0x20000002: EF
0x20000003: 01`;

    const result = parseMemory(input);
    expect(result).toHaveLength(4);
    expect(result[0].address).toBe('0x20000000');
    expect(result[0].value).toBe('AB');
    expect(result[3].address).toBe('0x20000003');
    expect(result[3].value).toBe('01');
  });

  it('should handle empty input', () => {
    expect(parseMemory('')).toEqual([]);
    expect(parseMemory('   \n  \n')).toEqual([]);
  });

  it('should parse values with or without 0x prefix', () => {
    const input = `0x08000000: 0x20001000
0x08000004: 0x08001234`;
    const result = parseMemory(input);
    expect(result).toHaveLength(2);
    expect(result[0].value).toBe('0x20001000');
  });
});

// ============================================================
// 4. OpenOCDClient state transition tests
// ============================================================
describe.skip('OpenOCDClient state transitions', () => {
  let client: OpenOCDClient;
  let mockStdout: EventEmitter;
  let mockStderr: EventEmitter;
  let mockKill: ReturnType<typeof vi.fn>;
  let exitCallback: ((code: number | null) => void) | null;
  let mockSocket: MockSocket;

  function getSocket(): MockSocket {
    return (client as any).socket as MockSocket;
  }

  // Helper: create a mock child process object
  function createMockProcess() {
    mockStdout = new EventEmitter();
    mockStderr = new EventEmitter();
    const mockOn = vi.fn();
    mockKill = vi.fn();
    exitCallback = null;

    const mockProcess = {
      stdout: mockStdout as any,
      stderr: mockStderr as any,
      stdin: { write: vi.fn() } as any,
      on: mockOn,
      kill: mockKill,
    };

    mockOn.mockImplementation((event: string, cb: (...args: any[]) => void) => {
      if (event === 'exit') {
        exitCallback = cb;
      }
    });

    return { mockProcess };
  }

  // Helper: start mock client into 'running' state
  async function startMockClient(config?: OpenOCDConfig) {
    const { mockProcess } = createMockProcess();
    vi.mocked(spawn).mockReturnValue(mockProcess as any);

    const realConfig: OpenOCDConfig = config || {
      openocdBin: 'openocd',
      scriptsDir: '/usr/share/openocd/scripts',
      interfaceType: 'stlink',
      target: 'stm32f1x',
    };

    const startPromise = client.start(realConfig);
    mockStderr.emit('data', 'Listening on port 4444 for telnet connections\n');
    await startPromise;

    expect(client.getState()).toBe('running');
    expect(client.isRunning).toBe(true);
  }

  beforeEach(() => {
    client = new OpenOCDClient();
    vi.clearAllMocks();
  });

  afterEach(async () => {
    if (client.isRunning) {
      await client.stop();
    }
    vi.restoreAllMocks();
  });

  // 4.1 Initial state
  it('should start in idle state', () => {
    expect(client.getState()).toBe('idle');
    expect(client.isRunning).toBe(false);
  });

  // 4.2 sendCommand in idle state throws
  it('should throw when sendCommand is called in idle state', async () => {
    await expect(client.sendCommand('reg')).rejects.toThrow('未运行');
  });

  // 4.3 stop in idle state does not throw
  it('should not throw when stop is called in idle state', async () => {
    await expect(client.stop()).resolves.not.toThrow();
  });

  // 4.4 Double start call rejects
  it('should reject duplicate start calls', async () => {
    const { mockProcess } = createMockProcess();
    vi.mocked(spawn).mockReturnValue(mockProcess as any);

    const config: OpenOCDConfig = {
      openocdBin: 'openocd',
      scriptsDir: '/usr/share/openocd/scripts',
      interfaceType: 'stlink',
      target: 'stm32f1x',
    };

    client.start(config).catch(() => {});
    await expect(client.start(config)).rejects.toThrow('已在运行中');
  });

  // 4.5 Positive flow: idle -> starting -> running
  it('should transition idle -> starting -> running on successful start', async () => {
    const { mockProcess } = createMockProcess();
    vi.mocked(spawn).mockReturnValue(mockProcess as any);

    const config: OpenOCDConfig = {
      openocdBin: 'openocd',
      scriptsDir: 'C:\\OpenOCD\\scripts',
      interfaceType: 'stlink',
      target: 'stm32f1x',
    };

    const startPromise = client.start(config);
    expect(client.getState()).toBe('starting');
    expect(client.isRunning).toBe(false);

    expect(spawn).toHaveBeenCalledTimes(1);
    expect(spawn).toHaveBeenCalledWith(
      config.openocdBin,
      expect.arrayContaining([expect.stringContaining('stlink')]),
      expect.any(Object),
    );

    mockStderr.emit('data', 'Listening on port 4444 for telnet connections\n');
    await startPromise;

    expect(client.getState()).toBe('running');
    expect(client.isRunning).toBe(true);
  });

  // 4.6 Start failure: error during startup
  it('should handle error during startup', async () => {
    const { mockProcess } = createMockProcess();
    vi.mocked(spawn).mockReturnValue(mockProcess as any);

    const config: OpenOCDConfig = {
      openocdBin: 'openocd',
      scriptsDir: '/usr/share/openocd/scripts',
      interfaceType: 'stlink',
      target: 'stm32f1x',
    };

    const startPromise = client.start(config);
    expect(client.getState()).toBe('starting');

    mockStderr.emit('data', 'Error: Could not find device');

    await expect(startPromise).rejects.toThrow('启动错误');
    // state remains 'starting' after error (code does not reset to idle)
    expect(client.getState()).toBe('starting');
  });

  // 4.7 Full end-to-end flow: start -> command -> stop
  it('should complete full flow: start -> send reg command -> stop', async () => {
    await startMockClient();

    const cmdPromise = client.sendCommand('reg');
    expect(getSocket().write).toHaveBeenCalledWith('reg\r\n');

    const response = `(0) r0 (/32): 0x20001000
(15) pc (/32): 0x08005678
> `;
    getSocket().emit('data', response);

    const result = await cmdPromise;
    expect(result).toContain('r0');
    expect(result).toContain('pc');
    expect(result).toContain('0x20001000');
    expect(result).toContain('0x08005678');

    // Verify parsed result matches expectations
    const parsedRegs = parseRegisters(result);
    expect(parsedRegs).toHaveLength(2);
    expect(parsedRegs[0].name).toBe('r0');
    expect(parsedRegs[0].value).toBe('0x20001000');
    expect(parsedRegs[1].name).toBe('pc');
    expect(parsedRegs[1].value).toBe('0x08005678');

    await client.stop();
    expect(client.getState()).toBe('idle');
    expect(client.isRunning).toBe(false);
  });

  // 4.8 Full flow: Flash Bank query
  it('should complete full flow: query flash banks and parse', async () => {
    await startMockClient();

    const cmdPromise = client.sendCommand('flash banks');
    expect(getSocket().write).toHaveBeenCalledWith('flash banks\r\n');

    const response = `#0 : stm32f1x.flash at 0x08000000, size 0x00010000, buswidth 0, chipwidth 0
> `;
    getSocket().emit('data', response);

    const result = await cmdPromise;
    const banks = parseFlashBanks(result);
    expect(banks).toHaveLength(1);
    expect(banks[0].bank).toBe(0);
    expect(banks[0].driver).toBe('stm32f1x.flash');
    expect(banks[0].address).toBe('0x08000000');
    expect(banks[0].size).toBe('0x00010000');

    await client.stop();
  });

  // 4.9 Full flow: Memory read
  it('should complete full flow: read memory and parse', async () => {
    await startMockClient();

    const cmdPromise = client.sendCommand('mdw 0x08000000 4');
    expect(getSocket().write).toHaveBeenCalledWith('mdw 0x08000000 4\r\n');

    const response = `0x08000000: 20001000
0x08000004: 08001234
0x08000008: 00000001
0x0800000C: DEADBEEF
> `;
    getSocket().emit('data', response);

    const result = await cmdPromise;
    const memRows = parseMemory(result);
    expect(memRows).toHaveLength(4);
    expect(memRows[0].address).toBe('0x08000000');
    expect(memRows[0].value).toBe('20001000');
    expect(memRows[3].address).toBe('0x0800000C');
    expect(memRows[3].value).toBe('DEADBEEF');

    await client.stop();
  });

  // 4.10 Unexpected process exit while running
  it('should transition to error state and reject pending command on unexpected exit', async () => {
    const { mockProcess } = createMockProcess();
    vi.mocked(spawn).mockReturnValue(mockProcess as any);

    const config: OpenOCDConfig = {
      openocdBin: 'openocd',
      scriptsDir: '/usr/share/openocd/scripts',
      interfaceType: 'stlink',
      target: 'stm32f1x',
    };

    const startPromise = client.start(config);
    mockStderr.emit('data', 'Listening on port 4444 for telnet connections\n');
    await startPromise;
    expect(client.getState()).toBe('running');

    // Issue a command that will be pending
    const cmdPromise = client.sendCommand('reg').catch((e) => e);

    // Trigger unexpected exit
    if (exitCallback) {
      exitCallback(-1);
    }

    const err = await cmdPromise;
    expect(err).toBeInstanceOf(Error);
    expect(err.message).toContain('意外退出');

    expect(client.getState()).toBe('error');
    expect(client.isRunning).toBe(false);
  });

  // 4.11 Command timeout
  it('should reject pending command on timeout', async () => {
    await startMockClient();

    // Use short timeout (100ms) to test the timeout mechanism
    const cmdPromise = client.sendCommand('reg', 100);
    await expect(cmdPromise).rejects.toThrow('超时');

    await client.stop();
  });

  // 4.12 Batch commands (sequential, each awaits response before sending next)
  it('should send and receive batch commands sequentially', async () => {
    await startMockClient();

    getSocket().write.mockClear();

    // batchCommands internally awaits each sendCommand, so only the first
    // command is written immediately; the rest wait for responses.
    const cmdPromise = client.batchCommands(['reg', 'flash banks', 'mdw 0x08000000 4']);

    // First command sent immediately
    expect(getSocket().write).toHaveBeenCalledTimes(1);
    expect(getSocket().write).toHaveBeenCalledWith('reg\r\n');

    // Respond to first command
    getSocket().emit('data', '(0) r0 (/32): 0x20001000\n> 
    // Wait a tick for the event loop to process
    await new Promise((r) => setTimeout(r, 0));

    // Now second command should be sent
    expect(getSocket().write).toHaveBeenCalledTimes(2);
    expect(getSocket().write).toHaveBeenNthCalledWith(2, 'flash banks\r\n');

    // Respond to second command
    getSocket().emit('data', '#0 : stm32f1x.flash at 0x08000000, size 0x00010000\n> 
    await new Promise((r) => setTimeout(r, 0));

    // Now third command should be sent
    expect(getSocket().write).toHaveBeenCalledTimes(3);
    expect(getSocket().write).toHaveBeenNthCalledWith(3, 'mdw 0x08000000 4\r\n');

    // Respond to third command
    getSocket().emit('data', '0x08000000: 20001000\n> 

    const results = await cmdPromise;
    expect(results).toHaveLength(3);
    expect(results[0]).toContain('r0');
    expect(results[1]).toContain('stm32f1x.flash');
    expect(results[2]).toContain('0x08000000');

    await client.stop();
  });

  // 4.13 Stop sends shutdown command
  it('should send shutdown command on stop', async () => {
    await startMockClient();

    getSocket().write.mockClear();
    const stopPromise = client.stop();

    // Simulate shutdown response
    getSocket().emit('data', 'shutdown command submitted\n> 

    await stopPromise;
    expect(getSocket().write).toHaveBeenCalledWith('shutdown\r\n');
    expect(client.getState()).toBe('idle');
    expect(client.isRunning).toBe(false);
  });

  // 4.14 Concurrent sendCommand writes both immediately (no internal queue)
  it('should write both commands when sendCommand is called concurrently', async () => {
    await startMockClient();

    getSocket().write.mockClear();

    // Issue two commands without awaiting — both write to stdin immediately
    const cmd1Promise = client.sendCommand('reg');
    const cmd2Promise = client.sendCommand('halt');

    // Both commands are written (no serialization in current implementation)
    expect(getSocket().write).toHaveBeenCalledTimes(2);
    expect(getSocket().write).toHaveBeenNthCalledWith(1, 'reg\r\n');
    expect(getSocket().write).toHaveBeenNthCalledWith(2, 'halt\r\n');

    // The second call overwrote pendingResolve, so only the last promise resolves
    getSocket().emit('data', 'target halted\n> 

    const result2 = await cmd2Promise;
    expect(result2).toContain('halted');

    await client.stop();
  });

  // 4.15 stop in error state is handled gracefully (process already null)
  it('should handle stop gracefully in error state', async () => {
    const { mockProcess } = createMockProcess();
    vi.mocked(spawn).mockReturnValue(mockProcess as any);

    const config: OpenOCDConfig = {
      openocdBin: 'openocd',
      scriptsDir: '/usr/share/openocd/scripts',
      interfaceType: 'stlink',
      target: 'stm32f1x',
    };

    const startPromise = client.start(config);
    mockStderr.emit('data', 'Listening on port 4444 for telnet connections\n');
    await startPromise;

    // Trigger exit to enter error state (process is set to null internally)
    if (exitCallback) {
      exitCallback(-1);
    }
    expect(client.getState()).toBe('error');

    // stop() resets state to idle even when process is already null
    await expect(client.stop()).resolves.not.toThrow();
    expect(client.getState()).toBe('idle');
  });
});
